# Normalize text without changing binary files.
* text=auto

# Unity YAML / editable source: consistent line endings, normal Git diffs.
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.asset      text=auto eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.playable   text eol=lf
*.mask       text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.renderTexture text eol=lf
*.terrainlayer text eol=lf

*.cs         text eol=lf diff=csharp
*.shader     text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.hlsl       text eol=lf
*.cginc      text eol=lf
*.compute    text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
*.txt        text=auto eol=lf
*.gltf       text eol=lf
*.mtl        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sh         text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Git LFS must be installed by each contributor.
# No custom merge driver is required by this file.

# Models and DCC source
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
*.[gG][lL][bB] filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
*.[dD][aA][eE] filter=lfs diff=lfs merge=lfs -text

# Textures and image sources
*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
*.[bB][mM][pP] filter=lfs diff=lfs merge=lfs -text
*.[tT][gG][aA] filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF] filter=lfs diff=lfs merge=lfs -text
*.[tT][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
*.[pP][sS][bB] filter=lfs diff=lfs merge=lfs -text
*.[eE][xX][rR] filter=lfs diff=lfs merge=lfs -text
*.[hH][dD][rR] filter=lfs diff=lfs merge=lfs -text

# Audio and video
*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]3 filter=lfs diff=lfs merge=lfs -text
*.[oO][gG][gG] filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF] filter=lfs diff=lfs merge=lfs -text
*.[aA][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
*.[fF][lL][aA][cC] filter=lfs diff=lfs merge=lfs -text
*.[mM][pP]4 filter=lfs diff=lfs merge=lfs -text
*.[mM][oO][vV] filter=lfs diff=lfs merge=lfs -text
*.[wW][eE][bB][mM] filter=lfs diff=lfs merge=lfs -text
*.[aA][vV][iI] filter=lfs diff=lfs merge=lfs -text

# Binary baked lighting
**/LightingData.asset filter=lfs diff=lfs merge=lfs -text !eol

# Project-specific exception: these serialized mesh files exceed GitHub's
# normal-file size limit. Their .meta files remain normal text.
Assets/wavesWater.Meshes/*.asset filter=lfs diff=lfs merge=lfs -text !eol
